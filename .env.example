DB_URL=jdbc:mysql://localhost:3306/alz_system?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=ZhangYu
DB_PASSWORD=zy6724845
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
PYTHON_DIAGNOSIS_URL=http://127.0.0.1:5000/api/diagnosis
PYTHON_CONNECT_TIMEOUT_MS=3000
PYTHON_READ_TIMEOUT_MS=120000
PYTHON_EXE=.venv/Scripts/python.exe
# If PYTHON_EXE/mock is missing, start.ps1 asks whether to create screening-service\.venv from requirements.txt.
PYTHON_AUTO_VENV=false
AUDIO_STORAGE_DIR=data/audio
PDF_STORAGE_DIR=data/pdf
ADMIN_AUDIO_STORAGE_DIR=data/admin_audio
SCREENING_ARTIFACT_DIR=data/screening-artifacts
# The default start.ps1 value enables the integrated Whisper + DeepSeek screening engine.
SCREENING_ENGINE_FACTORY=app.ad_diagnose_engine:create_engine
# true: DeepSeek Key 缺失时拒绝启动 AI 筛查，避免静默生成 quality-only 报告。
SCREENING_REQUIRE_AI=true
HF_ENDPOINT=https://huggingface.com
WHISPER_MODEL_SIZE=large-v2
WHISPER_DEVICE=cuda
WHISPER_DEVICE_INDEX=0
WHISPER_COMPUTE_TYPE=float16
GPU_STARTUP_FAILURE_POLICY=fail
# Optional PATH-style list. It can point Whisper to CUDA DLLs bundled by CUDA PyTorch.
CUDA_DLL_PATHS=screening-service/.venv-embedding/Lib/site-packages/torch/lib
# fail: stop startup when GPU prerequisites are incomplete; cpu: log and fall back explicitly.
GPU_STARTUP_FAILURE_POLICY=cpu
DEEPSEEK_SCREENING_MODEL=deepseek-v4-flash
DEEPSEEK_SCREENING_MAX_TOKENS=1500
DEEPSEEK_ENABLED=True
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=700
DEEPSEEK_CONNECT_TIMEOUT_MS=3000
DEEPSEEK_READ_TIMEOUT_MS=20000
DEEPSEEK_WEB_SEARCH_ENABLED=false
DEEPSEEK_WEB_SEARCH_MAX_USES=3
RAG_TOP_K=8
RAG_LOCAL_MIN_SCORE=16
# Allow initial vector bootstrap and the subsequent model response to finish.
RAG_STREAM_REQUEST_TIMEOUT=5m
RAG_MEMORY_MAX_TURNS=100
RAG_MEMORY_SUMMARY_INTERVAL=10
RAG_MEMORY_SUMMARY_MAX_CHARS=1800
RAG_MEMORY_CACHE_TTL_MINUTES=1440
RAG_MEMORY_GENERATION_TIMEOUT_SECONDS=180
RAG_MEMORY_SUMMARY_CONCURRENCY=2
RAG_MEMORY_SUMMARY_QUEUE_CAPACITY=100
RAG_VECTOR_ENABLED=false
QDRANT_BASE_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
# Optional native Windows executable. If blank and Docker is unavailable, start.ps1 downloads verified Qdrant v1.18.2.
QDRANT_EXE=
QDRANT_COLLECTION=alz_ad_knowledge
RAG_VECTOR_SCORE_THRESHOLD=0.72
RAG_VECTOR_BOOTSTRAP=true
# Build/validate the Qdrant knowledge index before the application becomes ready.
RAG_VECTOR_WARMUP_ENABLED=true
RAG_VECTOR_PAYLOAD_INDEX_ENABLED=true
RAG_EMBEDDING_ENABLED=true
RAG_EMBEDDING_BASE_URL=http://127.0.0.1:7997/v1
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DEVICE=cuda
RAG_EMBEDDING_DEVICE_INDEX=1
# Official PyTorch CUDA wheel settings used only when RAG_EMBEDDING_DEVICE=cuda.
RAG_EMBEDDING_TORCH_VERSION=2.8.0
RAG_EMBEDDING_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
RAG_EMBEDDING_BATCH_SIZE=16
RAG_EMBEDDING_PORT=7997
RAG_EMBEDDING_STARTUP_TIMEOUT_SECONDS=3600
RAG_EMBEDDING_CONNECT_TIMEOUT_MS=3000
RAG_EMBEDDING_READ_TIMEOUT_MS=30000

SCREENING_ASYNC_ENABLED=true
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/alz
RABBIT_PREFETCH=1
RABBITMQ_USERNAME=alz_app
RABBITMQ_PASSWORD=okHlsZkX1oP2gRmrHng37gb4AhRnblhifHFALTzHGqQ

SCREENING_RESULT_CONCURRENCY=2
SCREENING_STATUS_CONCURRENCY=2
PDF_WORKER_CONCURRENCY=1
SCREENING_LISTENER_QUEUE_CAPACITY=20
SCREENING_USER_MAX_ACTIVE=2
SCREENING_OUTBOX_DELAY_MS=1000
SCREENING_OUTBOX_BATCH_SIZE=20
SCREENING_PUBLISH_CONFIRM_TIMEOUT_MS=5000
SCREENING_WORKER_CONCURRENCY=2
SCREENING_TRANSCRIPTION_WORKERS=2
SCREENING_FEATURE_WORKERS=2
SCREENING_LLM_WORKERS=2
SCREENING_WORKER_MAX_RETRIES=3
SCREENING_RETRY_DELAY_MS=10000
